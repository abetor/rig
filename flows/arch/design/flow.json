{
  "_doc": "Architecture decision flow. Repository scouting is followed by three independent option sketches using minimalism, operations-risk, and reuse lenses. An architect synthesizes the sketches against explicit criteria, produces an ADR plan, and an isolated critic reviews the choice. A human reply loop approves or revises the plan before units write the ADR and any explicitly requested minimal skeleton. The flow then reconciles Git state and notifies completion.",
  "phases": [
    {
      "name": "scout",
      "agent": "scout",
      "kind": "readonly",
      "perms": "read",
      "on_fail": "continue"
    },
    {
      "name": "variant-simple",
      "agent": "scout",
      "kind": "readonly",
      "perms": "read",
      "prompt": "arch/design/prompts/variant-simple.md",
      "on_fail": "continue"
    },
    {
      "name": "variant-robust",
      "agent": "scout",
      "kind": "readonly",
      "perms": "read",
      "prompt": "arch/design/prompts/variant-robust.md",
      "on_fail": "continue"
    },
    {
      "name": "variant-leverage",
      "agent": "scout",
      "kind": "readonly",
      "perms": "read",
      "prompt": "arch/design/prompts/variant-leverage.md",
      "on_fail": "continue"
    },
    {
      "name": "plan",
      "agent": "plan",
      "kind": "validator",
      "on_fail": "stop"
    },
    {
      "name": "critic",
      "agent": "critic",
      "kind": "validator",
      "isolated": true,
      "on_fail": "continue"
    },
    {
      "name": "notify-plan",
      "agent": "notify",
      "kind": "validator",
      "action": "reply",
      "prompt": "architectural sketch ready\n{{plan}}",
      "on_fail": "continue"
    },
    {
      "name": "converse",
      "agent": "converse",
      "kind": "validator",
      "about": "plan",
      "on_fail": "stop"
    },
    {
      "name": "units",
      "agent": "units",
      "kind": "writer",
      "advances_base": true,
      "on_fail": "continue"
    },
    {
      "name": "reconcile",
      "agent": "reconcile",
      "kind": "validator",
      "on_fail": "continue"
    },
    {
      "name": "notify-done",
      "agent": "notify",
      "kind": "validator",
      "on_fail": "continue"
    }
  ]
}
