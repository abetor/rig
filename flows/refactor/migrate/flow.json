{
  "_doc": "Coordinated codebase migration. Initial scouting enumerates every old-pattern site and search method. A second read-only pass tries to falsify completeness and appends omissions. Planning groups exact sites into units, repeats the full migration rule in every instruction, and forbids behavior changes. Human coordination precedes unit execution, reconciliation, and notification.",
  "phases": [
    {
      "name": "scout",
      "agent": "scout",
      "kind": "readonly",
      "perms": "read",
      "on_fail": "continue"
    },
    {
      "name": "coverage",
      "agent": "scout",
      "kind": "readonly",
      "perms": "read",
      "prompt": "refactor/migrate/prompts/coverage.md",
      "on_fail": "continue"
    },
    {
      "name": "plan",
      "agent": "plan",
      "kind": "validator",
      "on_fail": "stop"
    },
    {
      "name": "critic",
      "agent": "critic",
      "kind": "validator",
      "isolated": true,
      "on_fail": "continue"
    },
    {
      "name": "notify-plan",
      "agent": "notify",
      "kind": "validator",
      "action": "reply",
      "prompt": "plan migration ready\n{{plan}}",
      "on_fail": "continue"
    },
    {
      "name": "converse",
      "agent": "converse",
      "kind": "validator",
      "about": "plan",
      "on_fail": "stop"
    },
    {
      "name": "units",
      "agent": "units",
      "kind": "writer",
      "advances_base": true,
      "on_fail": "continue"
    },
    {
      "name": "reconcile",
      "agent": "reconcile",
      "kind": "validator",
      "on_fail": "continue"
    },
    {
      "name": "notify-done",
      "agent": "notify",
      "kind": "validator",
      "on_fail": "continue"
    }
  ]
}
