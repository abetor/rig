{
  "_doc": "Feature flow with plan coordination. Scouting feeds planning and an advisory isolated critic. A reply loop lets the human revise the plan before units run. Units use correctness, security, and refutation review, advance the base only when green, then reconcile Git state and notify completion.",
  "phases": [
    {
      "name": "scout",
      "agent": "scout",
      "kind": "readonly",
      "perms": "read",
      "on_fail": "continue"
    },
    {
      "name": "plan",
      "agent": "plan",
      "kind": "validator",
      "on_fail": "stop"
    },
    {
      "name": "critic",
      "agent": "critic",
      "kind": "validator",
      "isolated": true,
      "on_fail": "continue"
    },
    {
      "name": "notify-plan",
      "agent": "notify",
      "kind": "validator",
      "action": "reply",
      "prompt": "plan ready\n{{plan}}",
      "on_fail": "continue"
    },
    {
      "name": "converse",
      "agent": "converse",
      "kind": "validator",
      "about": "plan",
      "on_fail": "stop"
    },
    {
      "name": "units",
      "agent": "units",
      "kind": "writer",
      "advances_base": true,
      "dimensions": [
        "correctness",
        "security",
        "refutation"
      ],
      "on_fail": "continue"
    },
    {
      "name": "reconcile",
      "agent": "reconcile",
      "kind": "validator",
      "on_fail": "continue"
    },
    {
      "name": "notify-done",
      "agent": "notify",
      "kind": "validator",
      "on_fail": "continue"
    }
  ]
}
